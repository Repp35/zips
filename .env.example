# Segredos
BOT_TOKEN=
MP_ACCESS_TOKEN=
PAYER_EMAIL=pagador@ghost.com

# IDs do servidor (sensíveis: ficam fora do código)
ADMIN_ID=
GUILD_ID=
SALES_CHANNEL_ID=
PEDIDO_RESTOCK_CHANNEL_ID=
AVISO_RESTOCK_CHANNEL_ID=
LOGS_CHANNEL_ID=
FA_CHANNEL_ID=
NFA_CHANNEL_ID=
SUPORTE_CHANNEL_ID=
NITRO_CHANNEL_ID=
CAPCUT_CHANNEL_ID=
SPOTIFY_CHANNEL_ID=

# Opcional
# Banco e diário ficam em data/ por padrão. Caminhos relativos partem da raiz do projeto.
# DB_PATH=data/banco.db
# Se os canais foram definidos pelo /setup no bot antigo, aponte para o banco antigo (ele guarda a config):
# DB_PATH=/caminho/do/banco-antigo.db

# Ghost Agent (IA do dono). Chave do modelo; o modelo padrão pode ser trocado.
# Provedor gratuito: groq (padrão), openrouter, gemini ou custom (qualquer API compatível com OpenAI)
AGENT_PROVIDER=groq
AGENT_API_KEY=
# AGENT_MODEL=llama-3.3-70b-versatile   (vazio = modelo padrão do provedor)
# AGENT_BASE_URL=https://seu-endpoint/v1  (só com AGENT_PROVIDER=custom)
# AGENT_CHANNEL_ID=id do canal 'Ghost agent' (só o dono fala lá)
# Compatibilidade com instalações antigas: AGENT_CANAL_ID também é aceito.

# Google Drive: cliente OAuth de aplicativo para computador baixado do Google Cloud.
# Gere o token uma vez com: python -m ghost.services.google_drive_auth
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_CREDENTIALS_FILE=google-drive-credentials.json
GOOGLE_DRIVE_TOKEN_FILE=data/google-drive-token.json
# Vazio = cria/usa "Ghost Bot Backups" na raiz do Drive.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_COMPRESS=true
GOOGLE_DRIVE_STATE_FILE=data/google-drive-state.json
